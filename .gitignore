# Root-level ignores for the VaidyaVani monorepo.
# Each package (app/, backend/, poc/) also has its own .gitignore for stack-specific paths.

# Secrets & local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Expo
node_modules/
.expo/
dist/
web-build/

# OS & editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
